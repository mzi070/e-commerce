PORT=3000
NODE_ENV=development

# JWT Secret — REQUIRED in production.
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Frontend origin for CORS — REQUIRED in production (e.g. https://your-app.example.com)
FRONTEND_URL=http://localhost:5173

# Path to the lowdb JSON database file. Defaults to db.json in the backend root.
# On platforms with ephemeral filesystems, point this to a persistent mount:
# DB_PATH=/data/db.json

# Redis URL for distributed rate limiting across multiple instances (optional).
# Falls back to in-memory (per-process) if unset — fine for single-instance dev/staging.
# REDIS_URL=redis://localhost:6379
