# ⚠️  This value is compiled INTO the JS bundle at build time by Vite — it is NOT read at runtime.
# You MUST set VITE_API_URL to your production API URL before running `npm run build`.
# If you build without it, every API call in the deployed app silently targets localhost.
#
# Example production build:
#   VITE_API_URL=https://your-api.example.com/api npm run build
VITE_API_URL=http://localhost:3000/api
